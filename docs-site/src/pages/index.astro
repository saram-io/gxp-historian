            href="#"
            target="_blank"
            rel="noopener noreferrer"
          >
            Open Original ↗
          </a>
          <button type="button" id="gxp-lightbox-close" class="gxp-lightbox-btn gxp-lightbox-close">
            ✕ Close (Esc)
          </button>
        </div>
      </div>
      <div id="gxp-lightbox-stage" class="gxp-lightbox-stage" tabindex="0" aria-label="Scrollable enlarged diagram canvas"></div>
      <div class="gxp-lightbox-footer">
        <span>Tip: Click the diagram to toggle zoom (100% ↔ 175%), drag to pan when zoomed, or use + / − / 0 keys.</span>
        <span>Click outside the modal or press Esc to close.</span>
      </div>
    </dialog>

    <script is:inline>
      (function () {
        let supportsDisplayTransition;
        function canTransitionDisplay() {
          if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
          if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete') || !document.body) {
            return false;
          }
          const probe = document.createElement('div');
          probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
          document.body.appendChild(probe);
          getComputedStyle(probe).display;
          probe.style.display = 'none';
          supportsDisplayTransition = getComputedStyle(probe).display === 'block';
          probe.remove();
          return supportsDisplayTransition;
        }

        function supportsTopLayerExit() {
          return Boolean(window.CSS?.supports?.('overlay', 'auto') && canTransitionDisplay());
        }

        async function closeTopLayer(dialog) {
          if (!dialog.open) return;
          if (!supportsTopLayerExit()) {
            dialog.setAttribute('data-closing', '');
            const animations = dialog.getAnimations({ subtree: true });
            if (animations.length > 0) {
              await Promise.race([
                Promise.allSettled(animations.map((a) => a.finished)),
                new Promise((r) => setTimeout(r, 2000)),
              ]);
            }
            if (!dialog.hasAttribute('data-closing')) return;
            dialog.removeAttribute('data-closing');
          }
          dialog.close();
        }

        const dialog = document.getElementById('gxp-image-lightbox');
        const stage = document.getElementById('gxp-lightbox-stage');
        const titleEl = document.getElementById('gxp-lightbox-title');
        const rawLink = document.getElementById('gxp-lightbox-raw');
        const closeBtn = document.getElementById('gxp-lightbox-close');
        if (!dialog || !stage || !titleEl || !rawLink) return;

        let currentZoom = 1;

        function applyLightboxZoom(zoom) {
          currentZoom = Math.min(3, Math.max(0.75, Math.round(zoom * 100) / 100));
          stage.style.setProperty('--gxp-zoom', String(currentZoom));
          stage.setAttribute('data-zoomed', currentZoom > 1 ? 'true' : 'false');
          dialog.querySelectorAll('button[data-zoom-preset]').forEach((btn) => {
            const preset = Number(btn.getAttribute('data-zoom-preset'));
            btn.setAttribute('aria-pressed', Math.abs(preset - currentZoom) < 0.05 ? 'true' : 'false');
          });
        }

        function openLightbox(src, alt) {
          stage.replaceChildren();
          titleEl.textContent = alt || 'Architecture Diagram';
          const enlargedImg = document.createElement('img');
          enlargedImg.src = src;
          enlargedImg.alt = alt || 'Enlarged diagram';
          stage.appendChild(enlargedImg);
          rawLink.href = src;
          applyLightboxZoom(1);
          if (!dialog.open) dialog.showModal();
        }

        if (!('closedBy' in HTMLDialogElement.prototype)) {
          dialog.addEventListener('click', (event) => {
            if (event.target !== dialog) return;
            const rect = dialog.getBoundingClientRect();
            const isDialogContent =
              rect.top <= event.clientY &&
              event.clientY <= rect.top + rect.height &&
              rect.left <= event.clientX &&
              event.clientX <= rect.left + rect.width;
            if (isDialogContent) return;
            closeTopLayer(dialog);
          });
        }

        dialog.addEventListener('cancel', (event) => {
          event.preventDefault();
          closeTopLayer(dialog);
        });

        closeBtn?.addEventListener('click', () => closeTopLayer(dialog));

        dialog.querySelectorAll('button[data-zoom-preset]').forEach((btn) => {
          btn.addEventListener('click', () => {
            applyLightboxZoom(Number(btn.getAttribute('data-zoom-preset') || '1'));
          });
        });

        dialog.querySelectorAll('button[data-zoom-step]').forEach((btn) => {
          btn.addEventListener('click', () => {
            applyLightboxZoom(currentZoom + Number(btn.getAttribute('data-zoom-step') || '0.25'));
          });
        });

        stage.addEventListener('click', (e) => {
          if (e.target === stage) return;
          applyLightboxZoom(currentZoom > 1.1 ? 1 : 1.75);
        });

        document
          .querySelectorAll('.arch-diagram-box img, .hero-photo-card img, .hmi-window-img')
          .forEach((img) => {
            img.style.cursor = 'zoom-in';
            img.addEventListener('click', () => {
              openLightbox(img.currentSrc || img.src, img.getAttribute('alt') || 'GxPHistorian Visual');
            });
          });
      })();
    </script>
  </body>
