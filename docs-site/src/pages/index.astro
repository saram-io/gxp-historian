      <!-- 21 CFR Part 11 & ALCOA+ Spotlight -->
      <section id="part11" class="section alt-bg deferred-section">
        <div class="container part11-grid">
          <div class="part11-copy">
            <span class="section-kicker">21 CFR Part 11 • EU GMP Annex 11 • ALCOA+</span>
            <h2>Cryptographic Data Integrity Enforced at the Database Kernel</h2>
            <p>
              Auditors no longer accept "trust the web application" for electronic batch records and excursion investigations. GxPHistorian enforces attribution, immutability, and non-repudiable electronic signatures inside PostgreSQL 16 and ClickHouse.
            </p>
            <ul class="part11-list">
              <li>
                <strong>Mandatory Session Attribution (<code>§11.10(e)</code>):</strong> Every DML change on all 10 GxP state tables (<code>asset_templates</code>, <code>assets</code>, <code>tags</code>, <code>event_frames</code>, <code>digital_state_sets</code>, <code>event_frame_templates</code>, <code>event_frame_signatures</code>, <code>manual_logger_entries</code>, <code>notification_rules</code>, and <code>notification_deliveries</code>) requires <code>app.actor_id</code> and <code>app.change_reason</code> or raises an immediate kernel exception.
              </li>
              <li>
                <strong>Unconditional WORM Audit Triggers:</strong> <code>trg_worm_part11_audit_log_stmt</code> and <code>trg_worm_part11_audit_log_row</code> block any <code>UPDATE</code>, <code>DELETE</code>, or <code>TRUNCATE</code> on <code>part11_audit_log</code>.
              </li>
              <li>
                <strong>SHA-256 Cryptographic Hash Chain:</strong> Each audit row chains <code>prev_hash || recorded_at || actor_id || operation || new_payload</code> from <code>GENESIS_0000000000000000</code>, verifiable via <code>GET /api/v1/audit-trail/verify</code>.
              </li>
              <li>
                <strong>Dual-Challenge Electronic Signatures (<code>§11.50</code>, <code>§11.70</code>, <code>§11.200</code>):</strong> Verifies bcrypt credentials in <code>users</code> and binds an <code>HMAC-SHA256</code> digest over <code>(event_id, user_id, signature_meaning, signed_at)</code>.
              </li>
            </ul>
            <div class="hero-cta-row">
              <a href="/docs/architecture/part11-compliance/" class="btn btn-primary">
                Read 21 CFR Part 11 Specification →
              </a>
              <a href="/docs/gxp-validation/06-iq-oq-evidence/" class="btn btn-secondary">
                View Executed OQ-01..OQ-05 Evidence
              </a>
            </div>
          </div>

          <div class="part11-code-panel">
            <div class="terminal-card">
              <div class="terminal-bar">
                <div class="terminal-dots" aria-hidden="true">
                  <span></span><span></span><span></span>
                </div>
                <span class="terminal-title">init-postgres/01_control_plane_part11.sql</span>
                <span class="terminal-status">WORM ACTIVE</span>
              </div>
              <pre class="terminal-body" tabindex="0"><code><span class="t-comment">-- Enforce mandatory 21 CFR Part 11 attribution context</span>
IF v_actor IS NULL OR v_reason IS NULL THEN
    RAISE EXCEPTION
        <span class="t-str">'21 CFR Part 11 Violation: actor_id and change_reason required'</span>;
END IF;

<span class="t-comment">-- Compute cryptographic SHA-256 hash chain link</span>
v_row_hash := encode(
    digest(
        v_prev_hash || v_recorded_at::text || v_actor || TG_OP ||
        COALESCE(v_new_payload::text, <span class="t-str">''</span>),
        <span class="t-str">'sha256'</span>
    ),
    <span class="t-str">'hex'</span>
);

<span class="t-comment">-- Unconditional WORM immutability (blocks even superusers)</span>
CREATE TRIGGER trg_worm_part11_audit_log_stmt
BEFORE UPDATE OR DELETE OR TRUNCATE ON part11_audit_log
FOR EACH STATEMENT EXECUTE FUNCTION fn_prevent_audit_tampering();</code></pre>
