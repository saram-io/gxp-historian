        const tagsEl = document.getElementById('tco-tags');
        const usersEl = document.getElementById('tco-users');
        const sitesEl = document.getElementById('tco-sites');
        const provEl = document.getElementById('tco-provider');
        if (!tagsEl || !usersEl || !sitesEl || !provEl) return;

        const fmtUsd = (n) => '$' + Math.round(n).toLocaleString('en-US');

        function updateTco() {
          const tags = parseInt(tagsEl.value, 10) || 25000;
          const users = parseInt(usersEl.value, 10) || 50;
          const sites = parseInt(sitesEl.value, 10) || 1;
          const prov = provEl.value || 'aws';

          document.getElementById('tco-tags-val').textContent = tags.toLocaleString('en-US') + ' tags';
          document.getElementById('tco-users-val').textContent = users.toLocaleString('en-US') + ' users ($0 seat tax)';
          document.getElementById('tco-sites-val').textContent = sites + (sites === 1 ? ' site' : ' sites');

          // Compression math at 70% deadband suppression (0.30 Hz effective, 2.5 bytes/sample)
          const annualGb = (tags * 86400 * 365.25 * 2.5 * 0.30) / Math.pow(1024, 3);
          const hotNvmeTb = Math.max(1.0, ((annualGb * 10) / 1024) * 1.30);
          const coldWormTb = Math.max(2.0, (annualGb * 5) / 1024 + 0.5);

          let recTitle = '';
          let baseSub = 54000;
          let edgeBoxes = 2;
          if (tags <= 2500 && sites === 1) {
            recTitle = 'Cloud Lab & Process Development (GXP-CLOUD-LAB-2K5)';
            baseSub = 18000;
            edgeBoxes = 1;
          } else if (tags <= 25000 && sites === 1) {
            recTitle = 'Clinical & Pilot cGMP Cloud (GXP-CLOUD-CLINICAL-25K)';
            baseSub = 54000;
            edgeBoxes = 2;
          } else {
            recTitle = 'Commercial cGMP & Enterprise Hub BYOC (GXP-CLOUD-BYOC-100K)';
            const extraTagBlocks = Math.max(0, Math.ceil((tags - 100000) / 50000));
            const extraSites = Math.max(0, sites - 3);
            baseSub = 150000 + extraTagBlocks * 35000 + extraSites * 24000;
            edgeBoxes = Math.max(2, sites * 2);
          }

          const gxpAnnual = baseSub + edgeBoxes * 2500;
          const legacyTagSub = Math.round(Math.max(28000, tags * 7.2 + sites * 25000) / 100) * 100;
          const legacySeatTax = users * 1200;
          const legacyCsv = sites * 65000;
          const legacyAnnual = legacyTagSub + legacySeatTax + legacyCsv;
          const annualSavings = Math.max(0, legacyAnnual - gxpAnnual);
          const threeYrSavings = annualSavings * 3;
          const reductionPct = Math.round((annualSavings / Math.max(1, legacyAnnual)) * 100);

          const vehicles = {
            aws: 'AWS Marketplace Private Offer (100% AWS EDP Eligible)',
            azure: 'Microsoft Azure Marketplace (100% Azure MACC Eligible)',
            gcp: 'Google Cloud Marketplace (100% GCP Commit Eligible)',
          };

          document.getElementById('tco-rec-title').textContent = recTitle;
          document.getElementById('tco-rec-vehicle').textContent =
            vehicles[prov] + ' • ' + edgeBoxes + '× Pre-Qualified Edge Boxes';
          document.getElementById('tco-reduction-badge').textContent = reductionPct + '% Lower TCO';
          document.getElementById('tco-gxp-annual').textContent = fmtUsd(gxpAnnual) + ' / yr';
          document.getElementById('tco-legacy-annual').textContent = fmtUsd(legacyAnnual) + ' / yr';
          document.getElementById('tco-3yr-savings').textContent = fmtUsd(threeYrSavings) + ' saved';
          document.getElementById('tco-storage-note').textContent =
            '10-Yr Hot NVMe: ' + hotNvmeTb.toFixed(1) + ' TB • 15-Yr WORM Cold Tier: ' + coldWormTb.toFixed(1) + ' TB';
        }

        tagsEl.addEventListener('input', updateTco);
        usersEl.addEventListener('input', updateTco);
        sitesEl.addEventListener('input', updateTco);
        provEl.addEventListener('change', updateTco);
        updateTco();
      })();
    </script>

    <!-- Modern Web Guidance (light-dismiss-a-dialog & platform-controls-dismiss-dialog):
         Native top-layer modal dialog with declarative closedby="any" light-dismiss -->
    <dialog id="gxp-image-lightbox" class="gxp-lightbox" closedby="any" aria-labelledby="gxp-lightbox-title">
