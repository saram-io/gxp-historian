  .hero-photo-caption strong {
    display: block;
    color: var(--text-primary);
  }

  .hero-photo-caption span {
    color: var(--text-muted);
  }

  .hero-photo-caption a {
    white-space: nowrap;
    font-weight: 700;
    color: var(--accent-primary);
    text-decoration: none;
  }

  /* Hero Full-Width Operator HMI Showcase Window */
  .hero-hmi-showcase {
    margin-block-start: 2.25rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-accent);
    border-radius: 0.85rem;
    overflow: hidden;
    box-shadow: 0 20px 45px -12px rgba(2, 132, 199, 0.32);
  }

  .hmi-window-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.65rem 1.1rem;
    background: #0f172a;
    border-block-end: 1px solid #1e293b;
  }

  .hmi-window-url {
    font-size: 0.78rem;
    color: #cbd5e1;
    font-family: var(--font-mono);
  }

  .hmi-window-cta {
    font-size: 0.78rem;
    font-weight: 700;
    color: #38bdf8;
    text-decoration: none;
  }

  .hmi-window-cta:hover {
    text-decoration: underline;
  }

  .hmi-window-img {
    display: block;
    width: 100%;
    height: auto;
  }

  .hmi-window-footer {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.75rem;
    padding: 0.85rem 1.15rem;
    background: var(--bg-elevated);
    border-block-start: 1px solid var(--border-subtle);
    font-size: 0.78rem;
    color: var(--text-secondary);
  }

  /* Metrics Strip */
  .metrics-strip {
    border-block: 1px solid var(--border-subtle);
    background: var(--bg-surface);
    padding-block: 1.75rem;
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.25rem;
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    padding-inline: 0.75rem;
    border-inline-start: 3px solid var(--accent-strong);
  }

  .metric-val {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    font-weight: 850;
    color: var(--accent-primary);
    line-height: 1.15;
  }

  .metric-label {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-block-start: 0.2rem;
  }

  .metric-sub {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  /* Generic Sections & Deferred Rendering */
  .section {
    padding-block: clamp(3.25rem, 6vw, 5.5rem);
  }

  .alt-bg {
    background: var(--bg-surface);
    border-block: 1px solid var(--border-subtle);
  }

  /* Modern Web Guidance: defer-rendering-heavy-content
     Apply content-visibility: auto paired with contain-intrinsic-size on strictly below-the-fold sections. */
  .deferred-section {
    content-visibility: auto;
    contain-intrinsic-size: auto none auto 680px;
  }

  .section-header {
    max-width: 72ch;
    margin-block-end: 2.5rem;
  }

  .section-kicker {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-primary);
    margin-block-end: 0.5rem;
  }

  .section-header h2 {
    font-size: clamp(1.65rem, 1.25rem + 1.5vw, 2.4rem);
  }

  .section-header p {
    color: var(--text-secondary);
    font-size: 1.02rem;
    margin: 0;
  }

  /* Differentiator Cards */
  .diff-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .diff-card,
  .pillar-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 0.85rem;
    padding: 1.65rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: var(--shadow-card);
  }

  .alt-bg .pillar-card {
    background: var(--bg-canvas);
  }

  .diff-number {
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--accent-secondary);
    margin-block-end: 0.6rem;
    font-family: var(--font-mono);
  }

  .diff-card h3,
  .pillar-card h3 {
    font-size: 1.22rem;
  }

  .diff-card p,
  .pillar-card p {
    color: var(--text-secondary);
    font-size: 0.94rem;
    margin-block: 0.5rem 1.25rem;
  }

  .card-link {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--accent-primary);
    text-decoration: none;
    margin-block-start: auto;
  }

  .card-link:hover {
    text-decoration: underline;
  }

  /* 4-Pillar Grid */
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 480px), 1fr));
    gap: 1.25rem;
    margin-block-end: 2rem;
  }

  .pillar-badge {
    align-self: flex-start;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.22rem 0.6rem;
    border-radius: 0.375rem;
    background: var(--badge-bg);
    color: var(--badge-text);
    border: 1px solid var(--border-accent);
    margin-block-end: 0.75rem;
  }

  .pillar-tech {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent-secondary);
    font-family: var(--font-mono);
    margin-block-end: 0.4rem;
  }

  .arch-diagram-box {
    background: var(--bg-canvas);
    border: 1px solid var(--border-subtle);
    border-radius: 0.85rem;
    padding: 1.25rem;
    box-shadow: var(--shadow-card);
  }

  .arch-diagram-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block-end: 1rem;
  }

  .arch-diagram-header strong {
    display: block;
    font-size: 1.05rem;
  }

  .arch-diagram-header span {
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .arch-diagram-box img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.5rem;
  }

  /* Parity Table */
  .parity-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--border-subtle);
    border-radius: 0.75rem;
    background: var(--bg-surface);
    box-shadow: var(--shadow-card);
  }

  .parity-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .parity-table th,
  .parity-table td {
    padding: 0.9rem 1.1rem;
    border-block-end: 1px solid var(--border-subtle);
    vertical-align: top;
    text-align: start;
  }

  .parity-table thead th {
    background: var(--bg-elevated);
    font-weight: 700;
    color: var(--text-primary);
  }

  .parity-table tbody tr:last-child td {
    border-block-end: none;
  }

  .td-pi {
    font-weight: 700;
    color: var(--text-primary);
    min-width: 220px;
  }

  .td-gxp {
    font-weight: 700;
    color: var(--accent-primary);
    font-family: var(--font-mono);
    font-size: 0.84rem;
    min-width: 250px;
  }

  .section-cta-bar {
    margin-block-start: 1.5rem;
    padding: 1.15rem 1.4rem;
    border-radius: 0.75rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-weight: 600;
  }

  .cta-bar-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  /* Part 11 Spotlight */
  .part11-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 62rem) {
    .part11-grid {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    }
  }

  .part11-copy,
  .part11-code-panel {
    min-inline-size: 0;
  }

  .part11-list {
    padding-inline-start: 1.2rem;
    margin-block: 1.25rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    color: var(--text-secondary);
  }

  /* Equipment Gallery Grid */
  .equip-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.5rem;
  }

  .equip-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 0.85rem;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: var(--shadow-card);
    transition: transform 0.18s ease, border-color 0.18s ease;
  }

  .equip-card:hover {
    transform: translateY(-3px);
    border-color: var(--accent-primary);
  }

  .equip-img-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #070d19;
    overflow: hidden;
  }

  .equip-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .equip-proto-badge {
    position: absolute;
    inset-block-end: 0.6rem;
    inset-inline-start: 0.6rem;
    padding: 0.2rem 0.55rem;
    border-radius: 0.35rem;
    font-size: 0.72rem;
    font-weight: 700;
    background: rgba(7, 13, 25, 0.88);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.45);
  }

  .equip-body {
    padding: 1.25rem 1.35rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .equip-category {
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-secondary);
    margin-block-end: 0.35rem;
  }

  .equip-body h3 {
    font-size: 1.1rem;
    margin-block-end: 0.45rem;
  }

  .equip-models {
    font-size: 0.84rem;
    color: var(--text-muted);
    margin-block: 0 1rem;
  }

  .equip-link-text {
    margin-block-start: auto;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent-primary);
  }

  /* Validation Binder Grid */
  .binder-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(265px, 1fr));
    gap: 1rem;
    margin-block-end: 2rem;
  }

  .binder-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.2rem 1.3rem;
    background: var(--bg-canvas);
    border: 1px solid var(--border-subtle);
    border-radius: 0.75rem;
    text-decoration: none;
    color: var(--text-primary);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .binder-card:hover {
    border-color: var(--accent-primary);
    transform: translateY(-2px);
  }

  .binder-doc-id {
    font-size: 0.74rem;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--accent-secondary);
  }

  .binder-arrow {
    margin-block-start: 0.4rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent-primary);
  }

  .binder-cta-banner {
    padding: 2rem;
    border-radius: 0.9rem;
    background: linear-gradient(135deg var(--in-oklab), rgba(2, 132, 199, 0.16), rgba(15, 118, 110, 0.16));
    border: 1px solid var(--border-accent);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .binder-cta-banner h3 {
    font-size: 1.35rem;
    margin-block-end: 0.4rem;
  }

  .binder-cta-banner p {
    margin: 0;
    max-width: 65ch;
    color: var(--text-secondary);
  }

  .binder-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Footer */
  .site-footer {
    padding-block: 3.5rem 2.5rem;
    background: var(--bg-canvas);
    border-block-start: 1px solid var(--border-subtle);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 2rem;
    margin-block-end: 2.5rem;
  }

  .footer-desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-block-start: 0.75rem;
  }

  .footer-col h4 {
    font-size: 0.9rem;
    margin-block-end: 0.75rem;
    color: var(--text-primary);
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .footer-col a {
    font-size: 0.85rem;
    color: var(--text-secondary);
    text-decoration: none;
  }

  .footer-col a:hover {
    color: var(--accent-primary);
    text-decoration: underline;
  }

  .footer-legal {
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--border-subtle);
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .footer-saram-link {
    color: var(--accent-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 600;
  }

  .footer-saram-link:hover {
    color: var(--accent-secondary);
  }

  /* Modern Web Guidance: size-aware-styling
     Use container-type: inline-size and @container rules so Implementation Service cards adapt to their container width. */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 480px), 1fr));
    gap: 1.35rem;
    margin-block-end: 2rem;
  }

  .service-card-container {
    container-type: inline-size;
  }

  .service-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 0.85rem;
    padding: 1.5rem;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    box-shadow: var(--shadow-card);
    transition: border-color 0.18s ease, transform 0.18s ease;
  }

  .service-card:hover {
    border-color: var(--accent-primary);
    transform: translateY(-2px);
  }

  .service-card-main {
    display: flex;
    flex-direction: column;
  }

  .service-card h3 {
    font-size: 1.18rem;
    margin-block-end: 0.45rem;
  }

  .service-card p {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin: 0;
  }

  @container (min-width: 520px) {
    .service-card {
      flex-direction: row;
      align-items: center;
      gap: 1.5rem;
    }

    .service-card .card-link {
      white-space: nowrap;
      margin-block-start: 0;
    }
  }

  /* GxPHistorian Cloud Commercial Tiers & TCO Calculator */
  .cloud-tiers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 1.5rem;
    margin-block-end: 2.5rem;
  }

  .cloud-tier-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 0.9rem;
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
    box-shadow: var(--shadow-card);
    min-inline-size: 0;
  }

  .cloud-tier-featured {
    border: 2px solid var(--accent-primary);
    background: linear-gradient(180deg var(--in-oklab), rgba(2, 132, 199, 0.1), var(--bg-surface) 42%);
  }

  .cloud-tier-card h3 {
    font-size: 1.28rem;
    margin-block: 0.35rem 0.5rem;
  }

  .cloud-price-block {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-block-end: 0.65rem;
  }

  .cloud-price-amount {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 800;
    color: var(--accent-secondary);
    line-height: 1.1;
  }

  .cloud-price-period {
    font-size: 0.84rem;
    color: var(--text-muted);
  }

  .cloud-tier-sub {
    font-size: 0.86rem;
    color: var(--text-secondary);
    margin-block: 0 1rem;
  }

  .cloud-feature-list {
    padding-inline-start: 1.15rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .tco-calc-box {
    background: var(--bg-surface);
    border: 1px solid var(--border-accent);
    border-radius: 0.95rem;
    padding: 1.75rem;
    box-shadow: var(--shadow-card);
  }

  .tco-calc-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding-block-end: 1.25rem;
    margin-block-end: 1.5rem;
    border-block-end: 1px solid var(--border-subtle);
  }

  .tco-calc-header h3 {
    font-size: 1.35rem;
    margin-block: 0.35rem;
  }

  .tco-calc-header p {
    margin: 0;
    max-width: 72ch;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .tco-calc-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 62rem) {
    .tco-calc-grid {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    }
  }

  .tco-controls,
  .tco-results {
    min-inline-size: 0;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .tco-control-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .tco-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.86rem;
  }

  .tco-label-row strong {
    color: var(--accent-primary);
  }

  .tco-control-group input[type='range'] {
    width: 100%;
    accent-color: var(--accent-primary);
    cursor: pointer;
  }

  .tco-range-hints {
    display: flex;
    justify-content: space-between;
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .tco-select {
    width: 100%;
    padding: 0.55rem 0.75rem;
    border-radius: 0.5rem;
    border: 1px solid var(--border-subtle);
    background: var(--bg-elevated);
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .tco-rec-banner {
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: 0.75rem;
    padding: 1.15rem 1.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
  }

  .tco-rec-kicker {
    display: block;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-secondary);
    font-weight: 700;
  }

  .tco-rec-banner h4 {
    font-size: 1.1rem;
    margin-block: 0.2rem;
  }

  .tco-rec-sub {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .tco-metrics-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 190px), 1fr));
    gap: 1rem;
  }

  .tco-metric-card {
    background: var(--bg-canvas);
    border: 1px solid var(--border-subtle);
    border-radius: 0.75rem;
    padding: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-inline-size: 0;
  }

  .tco-metric-highlight {
    border-color: var(--accent-secondary);
    background: linear-gradient(160deg var(--in-oklab), rgba(52, 211, 153, 0.1), var(--bg-canvas));
  }

  .tco-metric-label {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .tco-metric-val {
    font-family: var(--font-serif);
    font-size: 1.45rem;
    font-weight: 800;
    line-height: 1.15;
  }

  .tco-val-gxp {
    color: var(--accent-primary);
  }

  .tco-val-legacy {
    color: #f87171;
    text-decoration: line-through;
  }

  .tco-val-savings {
    color: var(--accent-secondary);
  }

  .tco-metric-note {
    font-size: 0.73rem;
    color: var(--text-secondary);
  }

  /* Lightbox Modal on Homepage */
  dialog.gxp-lightbox {
    width: min(96vw, 1740px);
    max-width: 96vw;
    height: min(93vh, 1080px);
    max-height: 93vh;
    margin: auto;
    padding: 0;
    border: 1px solid var(--border-accent);
    border-radius: 0.875rem;
    background: #0b1120;
    color: #f8fafc;
    box-shadow: 0 25px 60px -12px rgba(0, 0, 0, 0.78);
    overflow: hidden;
    opacity: 0;
    transform: scale(0.95);
    transition-property: opacity, transform, display, overlay;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
    transition-behavior: allow-discrete;
  }

  dialog.gxp-lightbox::backdrop {
