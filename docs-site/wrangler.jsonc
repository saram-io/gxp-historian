{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gxphistorian-docs",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "gxphistorian.com",
      "custom_domain": true
    },
    {
      "pattern": "www.gxphistorian.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true
  }
}
